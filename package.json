{
  "name": "cowish",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:front": "yarn workspace @cowish/frontend dev",
    "dev:back": "yarn workspace @cowish/backend dev",
    "build": "yarn workspaces run build",
    "test": "yarn workspaces run test",
    "audit:dependencies": "yarn audit --groups dependencies",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier . --write",
    "format:check": "prettier . --check"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.10.1",
    "typescript": ">=6.0.0 <6.1.0",
    "typescript-eslint": "^8.74.0"
  }
}
